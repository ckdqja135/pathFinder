generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  IT
  DESIGN
  MARKETING
  FINANCE
  BUSINESS
  MEDIA
  PUBLIC
  RESEARCH
}

enum EventType {
  CONFERENCE
  CERTIFICATION
  JOB_FAIR
  CONTEST
}

model Event {
  id                String     @id @default(cuid())
  title             String
  category          Category
  type              EventType
  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime?
  registrationEnd   DateTime?
  organizer         String
  location          String
  isOnline          Boolean    @default(false)
  fee               Int        @default(0)
  link              String
  description       String     @db.Text

  source     String
  externalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([startDate])
  @@index([category])
  @@index([type])
}
